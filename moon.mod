name = "vicTop-cw/mcpconftest"
version = "0.6.0"
readme = "README.md"
repository = "https://github.com/VictorTop/mcpconftest"
license = "Apache-2.0"
keywords = [ "mcp", "conformance", "test", "cli", "moonbit" ]
description = "MCP protocol conformance probe — checks any MCP server (stdio or WebSocket) against the spec. 14 check categories, 4 report formats (JSON/Markdown/HTML/JUnit), per-check timing, multi-server parallel probe, CI gate."
preferred_target = "js"

import {
  "moonbitlang/async@0.22.3",
}
